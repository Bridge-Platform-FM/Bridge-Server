{
    "name": "user-profile",
    "version": "1.0.0",
    "private": true,
    "type": "commonjs",
    "scripts": {
        "dev": "node --watch-path=./src src/app.js",
        "debug": "node --inspect src/app.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "migrate:make": "sequelize-mig migration:make -n",
        "migrate:run": "sequelize-cli db:migrate",
        "migrate:undo": "sequelize-cli db:migrate:undo"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1061.0",
        "@aws-sdk/s3-request-presigner": "^3.1062.0",
        "@sendgrid/mail": "^8.1.6",
        "bcrypt": "^6.0.0",
        "clamscan": "^2.4.0",
        "cors": "^2.8.6",
        "crypto": "^1.0.1",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "ioredis": "^5.11.0",
        "joi": "^18.2.1",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.1.1",
        "pdf-lib": "^1.17.1",
        "pg": "^8.21.0",
        "pg-hstore": "^2.3.4",
        "sequelize": "^6.37.8",
        "sharp": "^0.34.5",
        "twilio": "^6.0.2",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.4.0",
        "globals": "^17.6.0",
        "sequelize-cli": "^6.6.5",
        "sequelize-mig": "^3.1.3"
    }
}
